<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_request_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.request.wizard.form</field>
        <field name="model">otm.lead.export.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Export Unlock">
                <group>
                    <field name="reason" placeholder="Why do you need to export leads right now?"/>
                    <field name="minutes"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Send Request"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_request_wizard" model="ir.actions.act_window">
        <field name="name">Request Export</field>
        <field name="res_model">otm.lead.export.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
