<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 17's settings form (base.res_config_settings_view_form) ships
         completely EMPTY — `<form ...></form>`, no children at all. There
         is no pre-existing `<div class="settings">` to target (that was
         an older-Odoo convention). Every module that wants its own
         Settings tab inherits the bare form directly and adds a fresh
         `<app>` under `//form` — confirmed against the actual 17.0 core
         source (addons/crm/views/res_config_settings_views.xml uses this
         exact pattern). Corrected here after an earlier version used the
         older div/xpath convention and failed to install with
         "Element '<xpath expr=\"//div[hasclass('settings')]\">' cannot be
         located in parent view". -->
    <record id="res_config_settings_view_form_export_unlock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.otm.lead.export.guard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Lead Export" string="Lead Export" name="otm_lead_export_guard">
                    <block title="Lead Export Unlock">
                        <setting id="otm_export_notify_telegram_setting"
                                 string="Notify approvers on Telegram"
                                 help="Off by default. Not wired to a working Telegram integration yet — see this module's spec.md. Turning this on has no effect until that integration is built.">
                            <field name="otm_export_notify_telegram"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
