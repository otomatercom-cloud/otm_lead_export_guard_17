<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_enter_code_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.enter.code.wizard.form</field>
        <field name="model">otm.lead.export.enter.code.wizard</field>
        <field name="arch" type="xml">
            <form string="Enter Export Unlock Code">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="code" placeholder="6-digit code from your Approver"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Unlock"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_enter_code_wizard" model="ir.actions.act_window">
        <field name="name">Enter Code</field>
        <field name="res_model">otm.lead.export.enter.code.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
