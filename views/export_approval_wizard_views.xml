<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_approval_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.approval.wizard.form</field>
        <field name="model">otm.lead.export.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Pending Export Requests">
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="requester_id" readonly="1"/>
                        <field name="request_date" readonly="1"/>
                        <field name="minutes" readonly="1"/>
                        <field name="reason" readonly="1"/>
                        <button name="action_reveal" type="object" string="Reveal Code"
                                class="btn-primary" icon="fa-key"/>
                    </tree>
                </field>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_approval_wizard" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">otm.lead.export.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
