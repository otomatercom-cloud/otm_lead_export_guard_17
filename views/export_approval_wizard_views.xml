<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_export_approval_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.approval.wizard.form</field>
        <field name="model">otm.lead.export.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Pending Export Requests">
                <field name="line_ids">
                    <!-- Not editable="bottom" — every field here is readonly
                         and the only interaction is the action button, so
                         inline-edit mode isn't needed. editable="bottom" was
                         what caused Odoo's "Please click on the save button
                         first" warning with no actual Save button in reach. no_open="1": clicking a
                         row used to open an empty auto-generated form dialog
                         ("Open: Pending Requests", reported after a real test)
                         (reported after a real test) — a plain list view
                         doesn't demand that save step for an action button. -->
                    <tree create="0" delete="0" edit="0" no_open="1">
                        <field name="requester_id" readonly="1"/>
                        <field name="request_date" readonly="1"/>
                        <field name="minutes" readonly="1"/>
                        <field name="reason" readonly="1"/>
                        <button name="action_reveal" type="object" string="Reveal Code"
                                class="btn-primary" icon="fa-key"/>
                    </tree>
                </field>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_export_approval_wizard" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">otm.lead.export.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
