<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_export_access_list" model="ir.ui.view">
        <field name="name">res.users.export.access.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="otm_can_export_leads" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_users_export_access_search" model="ir.ui.view">
        <field name="name">res.users.export.access.search</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="login"/>
                <filter name="can_export" string="Can export" domain="[('otm_can_export_leads', '=', True)]"/>
                <filter name="cannot_export" string="Blocked" domain="[('otm_can_export_leads', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_lead_export_access" model="ir.actions.act_window">
        <field name="name">Lead Export Access</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="view_id" ref="view_users_export_access_list"/>
        <field name="search_view_id" ref="view_users_export_access_search"/>
    </record>

    <record id="view_lead_export_log_list" model="ir.ui.view">
        <field name="name">otm.lead.export.log.list</field>
        <field name="model">otm.lead.export.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-danger="result == 'blocked'">
                <field name="date"/>
                <field name="user_id"/>
                <field name="result"/>
                <field name="record_count"/>
                <field name="field_count"/>
                <field name="model"/>
            </tree>
        </field>
    </record>
    <record id="view_lead_export_log_search" model="ir.ui.view">
        <field name="name">otm.lead.export.log.search</field>
        <field name="model">otm.lead.export.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="blocked" string="Blocked" domain="[('result', '=', 'blocked')]"/>
                <filter name="allowed" string="Exported" domain="[('result', '=', 'allowed')]"/>
                <group>
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_result" string="Result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_lead_export_log" model="ir.actions.act_window">
        <field name="name">Lead Export Log</field>
        <field name="res_model">otm.lead.export.log</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_lead_export_root" name="Lead Export" parent="base.menu_administration"
              groups="base.group_system" sequence="90"/>
    <menuitem id="menu_lead_export_access" name="Export Access" parent="menu_lead_export_root"
              action="action_lead_export_access" sequence="1"/>
    <menuitem id="menu_lead_export_log" name="Export Log" parent="menu_lead_export_root"
              action="action_lead_export_log" sequence="2"/>
</odoo>
